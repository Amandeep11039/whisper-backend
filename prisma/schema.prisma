generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  pinHash     String
  lastReadAt  DateTime? // cursor: messages created after this are unread for this user
  createdAt   DateTime  @default(now())

  sentMessages Message[] @relation("SentMessages")

  @@index([username])
}

model Message {
  id        String   @id @default(cuid())
  senderId  String
  content   String   // pure plain text only
  createdAt DateTime @default(now())

  sender User @relation("SentMessages", fields: [senderId], references: [id])

  @@index([createdAt])
  @@index([senderId])
}

model RevokedToken {
  jti       String   @id       // JWT unique identifier (UUID)
  revokedAt DateTime @default(now())
  expiresAt DateTime            // expiry time for cleanup
}
